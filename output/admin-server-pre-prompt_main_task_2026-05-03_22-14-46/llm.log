async def query(
    environment_state_service,
    attack_graph_service,
):
    network = environment_state_service.network
    uninfected_hosts = network.get_uninfected_hosts()
    infected_hosts = [h for h in network.get_all_hosts() if h.infected]
    
    attack_paths = []
    for target in uninfected_hosts:
        for source in infected_hosts:
            paths = attack_graph_service.get_possible_attack_paths(
                attack_host=source,
                target_host=target,
                filter_paths=True
            )
            for path in paths:
                attack_paths.append({
                    "source": list(source.ip_addresses),
                    "target": list(target.ip_addresses),
                    "technique": str(path.attack_technique)
                })
    
    return attack_paths
</query>
