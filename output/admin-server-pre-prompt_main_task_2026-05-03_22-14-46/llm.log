            "ports": dict(host.open_ports),
            "users": list(host.users.keys())
        })
    
    return {
        "uninfected_hosts": uninfected_details,
        "total_hosts": len(all_hosts),
        "infected_count": len(all_hosts) - len(uninfected_hosts)
    }
