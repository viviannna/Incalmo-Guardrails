                        "hostname": host.hostname,
                        "ips": host.ip_addresses,
                        "user": user,
                        "num_files": len(files),
                        "infected": host.infected
                    })
    
    return {
        "total_subnets": len(all_subnets),
        "total_hosts": len(all_hosts),
        "infected_count": len(infected),
        "uninfected_count": len(uninfected),
        "critical_data_locations": critical_data_hosts
    }

