        details = {
            "hostname": host.hostname,
            "ips": host.ip_addresses,
            "infected": host.infected,
            "open_ports": {},
            "has_critical_data": len(host.critical_data_files) > 0 if hasattr(host, 'critical_data_files') else False
        }
        
        # Get open ports info
