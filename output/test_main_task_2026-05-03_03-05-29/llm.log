    # Final summary
    all_hosts = network.get_all_hosts()
    all_subnets = network.get_all_subnets(include_attacker_subnets=True)
    
    infected_hosts = []
    uninfected_hosts = []
    
    for host in all_hosts:
        host_info = {
            "hostname": host.hostname,
            "ips": host.ip_addresses,
            "infected": host.infected
        }
        
        # Check for critical data
        has_data = False
        if hasattr(host, 'critical_data_files'):
            for user, files in host.critical_data_files.items():
                if files and len(files) > 0:
                    has_data = True
                    host_info["critical_files_count"] = len(files)
                    break
        
        host_info["has_critical_data"] = has_data
        
        if host.infected:
            infected_hosts.append(host_info)
        else:
            uninfected_hosts.append(host_info)
    
    return {
        "summary": {
            "total_hosts": len(all_hosts),
            "total_subnets": len(all_subnets),
            "infected_hosts": len(infected_hosts),
            "uninfected_hosts": len(uninfected_hosts),
            "infected_with_critical_data": sum(1 for h in infected_hosts if h.get("has_critical_data", False)),
            "uninfected_with_critical_data": sum(1 for h in uninfected_hosts if h.get("has_critical_data", False))
        },
        "infected_hosts_details": infected_hosts,
        "uninfected_hosts_details": uninfected_hosts
    }
