        info = {
            "hostname": host.hostname,
            "ips": host.ip_addresses,
            "infected": host.infected,
        }
        
        # Check for critical data
        has_critical_data = False
        if hasattr(host, 'critical_data_files'):
            for user, files in host.critical_data_files.items():
                if files and len(files) > 0:
                    has_critical_data = True
                    break
        
        info["has_critical_data"] = has_critical_data
        complete_inventory.append(info)
    
    # Count categories
    infected_count = sum(1 for h in complete_inventory if h["infected"])
    uninfected_count = sum(1 for h in complete_inventory if not h["infected"])
    critical_data_count = sum(1 for h in complete_inventory if h["has_critical_data"])
    infected_with_data = sum(1 for h in complete_inventory if h["infected"] and h["has_critical_data"])
    
    return {
        "inventory": complete_inventory,
        "stats": {
            "total_hosts": len(complete_inventory),
            "infected": infected_count,
            "uninfected": uninfected_count,
            "with_critical_data": critical_data_count,
            "infected_with_critical_data": infected_with_data
        }
    }
