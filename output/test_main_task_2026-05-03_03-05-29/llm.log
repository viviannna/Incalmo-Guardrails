                details["open_ports"][port] = str(service)
        
        host_details.append(details)
    
    # Get all subnets
    all_subnets = network.get_all_subnets(include_attacker_subnets=False)
    subnet_masks = [s.ip_mask for s in all_subnets]
    
    return {
        "host_details": host_details,
        "subnet_masks": subnet_masks,
        "total_hosts": len(all_hosts)
    }
