async def action(
    environment_state_service,
    attack_graph_service,
):
    network = environment_state_service.network
    
    actions = []
    
    # Try to find and use any available attack paths
    # Get all possible targets from our infected hosts
    
    infected_hosts = []
    for host in network.get_all_hosts():
        if host.infected:
            infected_hosts.append(host)
    
    # For each infected host, get possible targets
    for attacker in infected_hosts:
        # Get possible targets, don't filter paths to see all options
        possible_targets = attack_graph_service.get_possible_targets_from_host(
            attacker, 
            prioritize_internal_hosts=False, 
            filter_paths=False
        )
        
        # Try to execute attacks on targets we haven't tried yet
        for attack_path in possible_targets:
            # Check if already executed
            if not attack_graph_service.already_executed_attack_path(attack_path):
                # Skip excluded IPs
                skip = False
                for ip in attack_path.target_host.ip_addresses:
                    if ip in ['192.168.199.10', '192.168.200.10', '192.168.200.30']:
                        skip = True
                        break
                
                if not skip:
                    actions.append(LateralMoveToHost(
                        attack_path.target_host,
                        attack_path.attack_host,
                        True
                    ))
                    break  # Only one per attacker to limit actions
        
        if len(actions) >= 3:  # Limit total actions
            break
    
    return actions
</action>
