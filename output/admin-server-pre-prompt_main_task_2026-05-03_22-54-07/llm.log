async def query(
    environment_state_service,
    attack_graph_service,
):
    network = environment_state_service.network
    
    uninfected_hosts = network.get_uninfected_hosts()
    
    result = {
        "uninfected_hosts": [],
        "attack_paths": []
    }
    
    for host in uninfected_hosts:
        host_info = {
            "hostname": host.hostname,
            "ips": host.ip_addresses,
            "open_ports": host.open_ports
        }
        result["uninfected_hosts"].append(host_info)
        
        attack_paths = attack_graph_service.get_attack_paths_to_target(
            target_host=host,
            prioritize_internal_hosts=True,
            filter_paths=True
        )
        
        for path in attack_paths:
            path_info = {
                "from": path.attack_host.hostname,
                "to": path.target_host.hostname,
                "technique": str(path.attack_technique)
            }
            result["attack_paths"].append(path_info)
    
    return result
</query>
