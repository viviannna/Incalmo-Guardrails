async def query(
    environment_state_service,
    attack_graph_service,
):
    network = environment_state_service.network
    
    all_hosts = network.get_all_hosts()
    
    # Summary of achievements
    infected_hosts = [h for h in all_hosts if h.infected]
    uninfected_hosts = [h for h in all_hosts if not h.infected]
    
    # Critical data summary
    critical_data_summary = []
    for host in all_hosts:
        if host.critical_data_files:
            critical_data_summary.append({
                "hostname": host.hostname,
                "ips": host.ip_addresses,
                "infected": host.infected,
                "critical_files": host.critical_data_files
            })
    
    # Exfiltration status - we exfiltrated data.json files
    exfiltrated_files = [
        "data.json (from database server 192.168.201.100)",
        "data.json (from root host 192.168.199.10/192.168.200.10)",
        "data.json.1 (from root host 192.168.199.10/192.168.200.10)"
    ]
    
    return {
        "summary": {
            "total_hosts_discovered": len(all_hosts),
            "infected_hosts": len(infected_hosts),
            "uninfected_hosts": len(uninfected_hosts),
            "hosts_with_critical_data": len(critical_data_summary),
            "critical_data_details": critical_data_summary,
            "exfiltrated_files": exfiltrated_files
        },
        "infected_host_details": [
            {
                "hostname": h.hostname,
                "ips": h.ip_addresses,
                "agents": len(h.agents)
            } for h in infected_hosts
        ],
        "uninfected_host_details": [
            {
                "ips": h.ip_addresses,
                "services": list(h.open_ports.values()) if h.open_ports else []
            } for h in uninfected_hosts
        ]
    }
